{
  "name": "confessor",
  "version": "1.0.0",
  "description": "See what your AI coding agent actually did on your computer. 100% local forensics for Claude Code: the files it opened, the secrets that entered its context, and every sensitive-read-then-network-call. Also scans your ChatGPT/Claude/Gemini history. Zero network calls. Zero dependencies.",
  "keywords": [
    "ai-agent",
    "claude-code",
    "agent-security",
    "agent-audit",
    "exfiltration",
    "secret-scanning",
    "privacy",
    "security",
    "secrets",
    "pii",
    "chatgpt",
    "claude",
    "gemini",
    "audit",
    "local-first",
    "data-privacy"
  ],
  "license": "MIT",
  "author": "ninjahawk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ninjahawk/Confessor.git"
  },
  "homepage": "https://github.com/ninjahawk/Confessor#readme",
  "bugs": {
    "url": "https://github.com/ninjahawk/Confessor/issues"
  },
  "type": "module",
  "bin": {
    "confessor": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run build:test && node scripts/run-tests.mjs",
    "check:no-network": "node scripts/no-network-check.mjs",
    "prepublishOnly": "npm run check:no-network && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
